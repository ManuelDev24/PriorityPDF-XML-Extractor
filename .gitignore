# Node modules and dependencies
node_modules/
*/node_modules/

# SQLite databases and temp files
*.db
*.db-wal
*.db-shm
*.sqlite
manifest-app/manifest.db

# Respaldos generados por "npm run backup" — nunca se versionan
backups/

# Salida del build de Vite: se genera con "npm run build", no se versiona.
# El instalador de produccion la genera en el servidor (Node 20 sobre Windows 10
# es plataforma Tier 1 y Vite 8 pide Node 20.19+, ambos verificados).
manifest-app/frontend/assets/
manifest-app/frontend/admin-vue.html

# Node.js binary packages & installation zips
node20/
*.zip
*.msi
*.log
node20-install.log

# Logs & temp directories
logs/
*/logs/
logs/*
*.tmp

# Environment local overrides
.env.local

# IDE & OS files
.vscode/
.vs/
*/.vs/
.claude/
*/.claude/
.idea/
.DS_Store
Thumbs.db
