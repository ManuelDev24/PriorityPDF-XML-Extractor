{
  // tsconfig "solución" — no compila nada por sí mismo (files: []), solo
  // referencia a los dos tsconfig reales del proyecto y declara el alias @
  // en un lugar que las herramientas de tooling (shadcn-vue CLI, editores)
  // esperan encontrar junto a vite.config.mts.
  //
  //   npm run typecheck        -> tsconfig.backend.json (JSDoc, backend/**/*.js)
  //   npm run typecheck:front  -> frontend-src/tsconfig.json (Vue + TS)
  "files": [],
  "references": [
    { "path": "./tsconfig.backend.json" },
    { "path": "./frontend-src/tsconfig.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./frontend-src/*"]
    }
  }
}
