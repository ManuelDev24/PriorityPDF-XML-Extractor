# Falla el npm install si la version de Node no cumple "engines" en package.json.
#
# Por que: better-sqlite3 es un modulo NATIVO, se compila contra la version de
# Node que ejecuta npm install. Si despues la aplicacion corre con otra version
# mayor, revienta en el arranque con un error de NODE_MODULE_VERSION que no
# dice nada util. Es preferible fallar aqui, con un mensaje claro.
engine-strict=true
